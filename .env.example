# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK (server-only — used to verify the admin's ID token in
# app/api/revalidate/route.ts). NEVER prefix these with NEXT_PUBLIC_ and NEVER
# expose them to the browser. Add the real values in .env.local (gitignored)
# and on Vercel (Project Settings -> Environment Variables).
#
# Create credentials from the Firebase console:
#   Project settings -> Service accounts -> Generate new private key.
# Then supply the private_key, client_email, and project_id from that JSON.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional comma-separated browser origins allowed to call /api/revalidate.
# When unset, any origin is accepted because authorization is enforced by the
# Firebase ID token. Example: https://admin.example.vercel.app,http://localhost:3001
REVALIDATE_ALLOWED_ORIGINS=